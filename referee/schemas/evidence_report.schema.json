{
  "$defs": {
    "EvidenceReport": {
      "additionalProperties": false,
      "properties": {
        "evidence_verdict": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL"
          ],
          "title": "Evidence Verdict",
          "type": "string"
        },
        "source_issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Source Issues",
          "type": "array"
        },
        "computation_issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Computation Issues",
          "type": "array"
        },
        "rule_violations": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Rule Violations",
          "type": "array"
        },
        "claim_provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Claim Provenance",
          "type": "array"
        },
        "reproducibility_notes": {
          "title": "Reproducibility Notes",
          "type": "string"
        }
      },
      "required": [
        "evidence_verdict",
        "source_issues",
        "computation_issues",
        "rule_violations",
        "claim_provenance",
        "reproducibility_notes"
      ],
      "title": "EvidenceReport",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "severity": {
          "enum": [
            "FATAL",
            "MISSING",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "detail",
        "severity"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "categories": {
          "items": {
            "enum": [
              "PROVED_BY_US",
              "KNOWN_IN_LITERATURE",
              "REPRODUCED_BY_US",
              "COMPUTATIONALLY_VERIFIED",
              "EXPERIMENTAL_ONLY",
              "UNVERIFIED"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "evidence_sufficient": {
          "title": "Evidence Sufficient",
          "type": "boolean"
        },
        "permitted_by_rules": {
          "title": "Permitted By Rules",
          "type": "boolean"
        },
        "relies_on_external_result": {
          "title": "Relies On External Result",
          "type": "boolean"
        },
        "uses_computation_as_proof": {
          "title": "Uses Computation As Proof",
          "type": "boolean"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "categories",
        "evidence_sufficient",
        "permitted_by_rules",
        "relies_on_external_result",
        "uses_computation_as_proof",
        "references",
        "notes"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Limitation"
    }
  },
  "required": [
    "report",
    "limitation"
  ],
  "title": "AgentEnvelope[EvidenceReport]",
  "type": "object"
}
