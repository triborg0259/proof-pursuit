{
  "$defs": {
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "severity": {
          "enum": [
            "FATAL",
            "MISSING",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "detail",
        "severity"
      ],
      "title": "Issue",
      "type": "object"
    },
    "MathReport": {
      "additionalProperties": false,
      "properties": {
        "mathematical_verdict": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL"
          ],
          "title": "Mathematical Verdict",
          "type": "string"
        },
        "first_fatal_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Issue"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_mathematical_claims": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Mathematical Claims",
          "type": "array"
        },
        "unproved_claims": {
          "items": {
            "type": "string"
          },
          "title": "Unproved Claims",
          "type": "array"
        },
        "missing_cases": {
          "items": {
            "type": "string"
          },
          "title": "Missing Cases",
          "type": "array"
        },
        "math_notes": {
          "title": "Math Notes",
          "type": "string"
        }
      },
      "required": [
        "mathematical_verdict",
        "first_fatal_error",
        "accepted_mathematical_claims",
        "unproved_claims",
        "missing_cases",
        "math_notes"
      ],
      "title": "MathReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/MathReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Limitation"
    }
  },
  "required": [
    "report",
    "limitation"
  ],
  "title": "AgentEnvelope[MathReport]",
  "type": "object"
}
