{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "title": "Verdict",
          "type": "string"
        },
        "source_issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Source Issues",
          "type": "array"
        },
        "computation_issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Computation Issues",
          "type": "array"
        },
        "rule_violations": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Rule Violations",
          "type": "array"
        },
        "claim_provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Claim Provenance",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "source_issues",
        "computation_issues",
        "rule_violations",
        "claim_provenance"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "severity": {
          "enum": [
            "FATAL",
            "MISSING",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "detail",
        "severity"
      ],
      "title": "Issue",
      "type": "object"
    },
    "MathSummary": {
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "title": "Verdict",
          "type": "string"
        },
        "first_fatal_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Issue"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_claims": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Claims",
          "type": "array"
        },
        "unproved_claims": {
          "items": {
            "type": "string"
          },
          "title": "Unproved Claims",
          "type": "array"
        },
        "missing_cases": {
          "items": {
            "type": "string"
          },
          "title": "Missing Cases",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "first_fatal_error",
        "accepted_claims",
        "unproved_claims",
        "missing_cases"
      ],
      "title": "MathSummary",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "categories": {
          "items": {
            "enum": [
              "PROVED_BY_US",
              "KNOWN_IN_LITERATURE",
              "REPRODUCED_BY_US",
              "COMPUTATIONALLY_VERIFIED",
              "EXPERIMENTAL_ONLY",
              "UNVERIFIED"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "evidence_sufficient": {
          "title": "Evidence Sufficient",
          "type": "boolean"
        },
        "permitted_by_rules": {
          "title": "Permitted By Rules",
          "type": "boolean"
        },
        "relies_on_external_result": {
          "title": "Relies On External Result",
          "type": "boolean"
        },
        "uses_computation_as_proof": {
          "title": "Uses Computation As Proof",
          "type": "boolean"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "categories",
        "evidence_sufficient",
        "permitted_by_rules",
        "relies_on_external_result",
        "uses_computation_as_proof",
        "references",
        "notes"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "final_verdict": {
      "enum": [
        "ACCEPT",
        "PARTIAL_PROGRESS",
        "REJECT",
        "COUNTEREXAMPLE_FOUND",
        "KNOWN_OPEN",
        "UNKNOWN_STATUS"
      ],
      "title": "Final Verdict",
      "type": "string"
    },
    "highest_verified_cell": {
      "title": "Highest Verified Cell",
      "type": "integer"
    },
    "math_review": {
      "$ref": "#/$defs/MathSummary"
    },
    "evidence_review": {
      "$ref": "#/$defs/EvidenceSummary"
    },
    "accepted_progress": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Accepted Progress",
      "type": "array"
    },
    "blocking_issue": {
      "title": "Blocking Issue",
      "type": "string"
    },
    "next_required_step": {
      "title": "Next Required Step",
      "type": "string"
    },
    "stagnation_signal": {
      "title": "Stagnation Signal",
      "type": "boolean"
    }
  },
  "required": [
    "final_verdict",
    "highest_verified_cell",
    "math_review",
    "evidence_review",
    "accepted_progress",
    "blocking_issue",
    "next_required_step",
    "stagnation_signal"
  ],
  "title": "FinalReport",
  "type": "object"
}
